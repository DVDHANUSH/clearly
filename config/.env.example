# Copy this file to .env for local development. Never commit the real .env file.

# Database
MYSQL_URL=jdbc:mysql://localhost:3306/clearly_store?createDatabaseIfNotExist=true&serverTimezone=UTC
MYSQL_USER=root
MYSQL_PASSWORD=

# Authentication
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRY_HOURS=24
GOOGLE_CLIENT_ID=
AUTH_DEV_EXPOSE_OTP=true

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Internal services
EUREKA_URL=http://localhost:8761/eureka
NOTIFICATION_SERVICE_URL=http://localhost:8084
NOTIFICATION_INTERNAL_KEY=replace-with-a-long-random-value
STOREFRONT_PUBLIC_URL=http://127.0.0.1:4173

# Email
AUTH_MAIL_ENABLED=false
ORDER_EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
ORDER_EMAIL_FROM=
ORDER_EMAIL_REPLY_TO=
ORDER_EMAIL_SENDER_NAME=Clearly Orders
CONTACT_ENQUIRY_TO=adhithyachem@gmail.com

# Twilio SMS (WhatsApp remains disabled unless explicitly enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
ORDER_SMS_ENABLED=false
ORDER_WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Infrastructure
KAFKA_BROKERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
CONFIG_REPOSITORY_URL=https://github.com/DVDHANUSH/minup-config.git
CONFIG_REPOSITORY_BRANCH=main
CONFIG_ENCRYPT_KEY=replace-with-a-long-random-value
